@using Bookly.Helpers
@model Bookly.Models.VendedorCardViewModel

@{
    var avatarSrc = !string.IsNullOrWhiteSpace(Model.FotoPerfil)
        ? Model.FotoPerfil
        : Url.Content("~/img/default.webp");

    string ventasStr;
    if (Model.VentasCerradas >= 10)
    {
        var decena = (Model.VentasCerradas / 10) * 10;
        ventasStr = decena + "+";
    }
    else
    {
        ventasStr = Model.VentasCerradas.ToString();
    }

    // ── Atención ──
    string atencionLabel; string atencionIconMain; string atencionBadgeSvg;
    if (Model.PromedioAtencion == null)
    {
        atencionLabel = ""; atencionIconMain = ""; atencionBadgeSvg = "";
    }
    else if (Model.PromedioAtencion <= 5.0 / 3)
    {
        atencionLabel    = "Mala atención";
        atencionIconMain = "<svg xmlns='http://www.w3.org/2000/svg' width='26' height='26' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round'><path stroke='none' d='M0 0h24v24H0z' fill='none'/><path d='M8 9h8'/><path d='M8 13h6'/><path d='M18 4a3 3 0 0 1 3 3v8a3 3 0 0 1 -3 3h-5l-5 3v-3h-2a3 3 0 0 1 -3 -3v-8a3 3 0 0 1 3 -3h12z'/></svg>";
        atencionBadgeSvg = "<svg xmlns='http://www.w3.org/2000/svg' width='11' height='11' viewBox='0 0 24 24' fill='#f59e0b' stroke='none'><path stroke='none' d='M0 0h24v24H0z' fill='none'/><path d='M12 1.67c.955 0 1.845 .467 2.39 1.247l.105 .16l8.114 13.548a2.928 2.928 0 0 1 -2.307 4.363l-.195 .008h-16.225a2.928 2.928 0 0 1 -2.582 -4.2l.099 -.185l8.11 -13.539a2.928 2.928 0 0 1 2.491 -1.402zm0 10.33a1 1 0 0 0 -1 1v2a1 1 0 0 0 2 0v-2a1 1 0 0 0 -1 -1zm0 -4a1 1 0 0 0 0 2a1 1 0 0 0 0 -2z'/></svg>";
    }
    else if (Model.PromedioAtencion <= 10.0 / 3)
    {
        atencionLabel    = "Atención regular";
        atencionIconMain = "<svg xmlns='http://www.w3.org/2000/svg' width='26' height='26' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round'><path stroke='none' d='M0 0h24v24H0z' fill='none'/><path d='M8 9h8'/><path d='M8 13h6'/><path d='M18 4a3 3 0 0 1 3 3v8a3 3 0 0 1 -3 3h-5l-5 3v-3h-2a3 3 0 0 1 -3 -3v-8a3 3 0 0 1 3 -3h12z'/></svg>";
        atencionBadgeSvg = "<svg xmlns='http://www.w3.org/2000/svg' width='11' height='11' viewBox='0 0 24 24' fill='#64748b' stroke='none'><path stroke='none' d='M0 0h24v24H0z' fill='none'/><path d='M17 3.34a10 10 0 1 1 -14.995 8.984l-.005 -.324l.005 -.324a10 10 0 0 1 14.995 -8.336z'/><rect x='7' y='10.75' width='10' height='2.5' rx='1.25' fill='white'/></svg>";
    }
    else
    {
        atencionLabel    = "Buena atención";
        atencionIconMain = "<svg xmlns='http://www.w3.org/2000/svg' width='26' height='26' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round'><path stroke='none' d='M0 0h24v24H0z' fill='none'/><path d='M8 9h8'/><path d='M8 13h6'/><path d='M18 4a3 3 0 0 1 3 3v8a3 3 0 0 1 -3 3h-5l-5 3v-3h-2a3 3 0 0 1 -3 -3v-8a3 3 0 0 1 3 -3h12z'/></svg>";
        atencionBadgeSvg = "<svg xmlns='http://www.w3.org/2000/svg' width='11' height='11' viewBox='0 0 24 24' fill='#22c55e' stroke='none'><path stroke='none' d='M0 0h24v24H0z' fill='none'/><path d='M17 3.34a10 10 0 1 1 -14.995 8.984l-.005 -.324l.005 -.324a10 10 0 0 1 14.995 -8.336zm-1.293 5.953a1 1 0 0 0 -1.32 -.083l-.094 .083l-3.293 3.292l-1.293 -1.292l-.094 -.083a1 1 0 0 0 -1.403 1.403l.083 .094l2 2l.094 .083a1 1 0 0 0 1.226 0l.094 -.083l4 -4l.083 -.094a1 1 0 0 0 -.083 -1.32z'/></svg>";
    }

    // ── Entrega ──
    string entregaLabel; string entregaIconMain; string entregaBadgeSvg;
    if (Model.PromedioEntrega == null)
    {
        entregaLabel = ""; entregaIconMain = ""; entregaBadgeSvg = "";
    }
    else if (Model.PromedioEntrega <= 5.0 / 3)
    {
        entregaLabel    = "No entrega a tiempo";
        entregaIconMain = "<svg xmlns='http://www.w3.org/2000/svg' width='26' height='26' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round'><path stroke='none' d='M0 0h24v24H0z' fill='none'/><circle cx='12' cy='12' r='9'/><path d='M12 7v5l2.5 2.5'/></svg>";
        entregaBadgeSvg = "<svg xmlns='http://www.w3.org/2000/svg' width='11' height='11' viewBox='0 0 24 24' fill='#f59e0b' stroke='none'><path stroke='none' d='M0 0h24v24H0z' fill='none'/><path d='M12 1.67c.955 0 1.845 .467 2.39 1.247l.105 .16l8.114 13.548a2.928 2.928 0 0 1 -2.307 4.363l-.195 .008h-16.225a2.928 2.928 0 0 1 -2.582 -4.2l.099 -.185l8.11 -13.539a2.928 2.928 0 0 1 2.491 -1.402zm0 10.33a1 1 0 0 0 -1 1v2a1 1 0 0 0 2 0v-2a1 1 0 0 0 -1 -1zm0 -4a1 1 0 0 0 0 2a1 1 0 0 0 0 -2z'/></svg>";
    }
    else if (Model.PromedioEntrega <= 10.0 / 3)
    {
        entregaLabel    = "Entrega irregular";
        entregaIconMain = "<svg xmlns='http://www.w3.org/2000/svg' width='26' height='26' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round'><path stroke='none' d='M0 0h24v24H0z' fill='none'/><circle cx='12' cy='12' r='9'/><path d='M12 7v5l2.5 2.5'/></svg>";
        entregaBadgeSvg = "<svg xmlns='http://www.w3.org/2000/svg' width='11' height='11' viewBox='0 0 24 24' fill='#64748b' stroke='none'><path stroke='none' d='M0 0h24v24H0z' fill='none'/><path d='M17 3.34a10 10 0 1 1 -14.995 8.984l-.005 -.324l.005 -.324a10 10 0 0 1 14.995 -8.336z'/><rect x='7' y='10.75' width='10' height='2.5' rx='1.25' fill='white'/></svg>";
    }
    else
    {
        entregaLabel    = "Entrega a tiempo";
        entregaIconMain = "<svg xmlns='http://www.w3.org/2000/svg' width='26' height='26' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='1.6' stroke-linecap='round' stroke-linejoin='round'><path stroke='none' d='M0 0h24v24H0z' fill='none'/><circle cx='12' cy='12' r='9'/><path d='M12 7v5l2.5 2.5'/></svg>";
        entregaBadgeSvg = "<svg xmlns='http://www.w3.org/2000/svg' width='11' height='11' viewBox='0 0 24 24' fill='#22c55e' stroke='none'><path stroke='none' d='M0 0h24v24H0z' fill='none'/><path d='M17 3.34a10 10 0 1 1 -14.995 8.984l-.005 -.324l.005 -.324a10 10 0 0 1 14.995 -8.336zm-1.293 5.953a1 1 0 0 0 -1.32 -.083l-.094 .083l-3.293 3.292l-1.293 -1.292l-.094 -.083a1 1 0 0 0 -1.403 1.403l.083 .094l2 2l.094 .083a1 1 0 0 0 1.226 0l.094 -.083l4 -4l.083 -.094a1 1 0 0 0 -.083 -1.32z'/></svg>";
    }

    // ── Segmento activo ──
    int segActivo = 0;
    if (Model.PromedioAtencion.HasValue && Model.PromedioEntrega.HasValue)
    {
        double global = (Model.PromedioAtencion.Value + Model.PromedioEntrega.Value) / 2.0;
        segActivo = (int)Math.Round(global, MidpointRounding.AwayFromZero);
        segActivo = Math.Max(1, Math.Min(5, segActivo));
    }

    var maxPubs = Math.Min(Model.Publicaciones.Count, 4);
}

<div class="det-vendedor-card">
    <div class="det-vendedor-top">
        <img src="@avatarSrc" alt="perfil" class="det-vendedor-avatar" id="avatarVendedorChat" style="cursor:pointer;" title="Ver foto" />
        <div>
            <span class="det-vendedor-pill">@(Model.Pill ?? "Contacto")</span>
            <p class="det-vendedor-nombre">@Model.NombreComp</p>
            <p class="det-vendedor-sub">
                @if (Model.Ano.HasValue)
                {
                    @HtmlHelpers.PasarAñoATextoCompleto(Model.Ano.Value)
                    if (!string.IsNullOrWhiteSpace(Model.Especialidad) || !string.IsNullOrWhiteSpace(Model.Curso))
                    {
                        <text> · </text>
                    }
                }
                @Model.Especialidad @Model.Curso
            </p>
            @if (!string.IsNullOrWhiteSpace(Model.AboutMe))
            {
                <p class="det-vendedor-about">@Model.AboutMe</p>
            }
        </div>
    </div>

    @* ── Stats ── *@
    <div class="det-vendedor-stats-widget">
        <span class="det-rep-resena-count">(@Model.ResenaCount @(Model.ResenaCount == 1 ? "reseña" : "reseñas"))</span>
        <div class="det-rep-barra-segmentada">
            <div class="det-rep-seg det-rep-seg-1 @(segActivo == 1 ? "det-rep-seg--activo" : "")"></div>
            <div class="det-rep-seg det-rep-seg-2 @(segActivo == 2 ? "det-rep-seg--activo" : "")"></div>
            <div class="det-rep-seg det-rep-seg-3 @(segActivo == 3 ? "det-rep-seg--activo" : "")"></div>
            <div class="det-rep-seg det-rep-seg-4 @(segActivo == 4 ? "det-rep-seg--activo" : "")"></div>
            <div class="det-rep-seg det-rep-seg-5 @(segActivo == 5 ? "det-rep-seg--activo" : "")"></div>
        </div>
        <div class="det-rep-stats-row">
            <div class="det-rep-stat det-rep-stat--ventas">
                <span class="det-rep-stat-num">@ventasStr</span>
                <span class="det-rep-stat-desc">ventas</span>
            </div>
            @if (Model.ResenaCount > 0)
            {
                <div class="det-rep-divider"></div>
                <div class="det-rep-stat">
                    <div class="det-rep-stat-icon-wrap">
                        @Html.Raw(atencionIconMain)
                        <span class="det-rep-check">@Html.Raw(atencionBadgeSvg)</span>
                    </div>
                    <span class="det-rep-stat-desc">@atencionLabel</span>
                </div>
                <div class="det-rep-divider"></div>
                <div class="det-rep-stat">
                    <div class="det-rep-stat-icon-wrap">
                        @Html.Raw(entregaIconMain)
                        <span class="det-rep-check">@Html.Raw(entregaBadgeSvg)</span>
                    </div>
                    <span class="det-rep-stat-desc">@entregaLabel</span>
                </div>
            }
        </div>
    </div>

    @* ── Publicaciones ── *@
    @if (maxPubs > 0)
    {
        <div class="det-otras">
            <span class="det-otras-label">Publicaciones <span class="det-otras-count">(@Model.PublicacionesActivas)</span></span>
            <div class="det-otras-grid">
                @for (int i = 0; i < maxPubs; i++)
                {
                    var pubImg = !string.IsNullOrWhiteSpace(Model.Publicaciones[i].imagen)
                        ? Model.Publicaciones[i].imagen
                        : Url.Content("~/img/book-placeholder.webp");
                    <a class="det-otras-thumb" href="@Url.Action("Detalle", "Book", new { id = Model.Publicaciones[i].id })">
                        <img src="@pubImg" alt="@Model.Publicaciones[i].nombre" loading="lazy" />
                        <div class="det-otras-thumb-info">
                            <span class="det-otras-thumb-nombre">@Model.Publicaciones[i].nombre</span>
                            <span class="det-otras-thumb-precio">$@Model.Publicaciones[i].precio</span>
                        </div>
                    </a>
                }
            </div>
        </div>
    }
</div>
