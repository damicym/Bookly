@using Bookly.Helpers

@{
    ViewData["Title"] = "Chat";
    var vendedor = (Bookly.Models.Usuarios)ViewBag.Vendedor;
    var publicacionConsulta = ViewBag.PublicacionConsulta as Bookly.Models.PublicacionesCompletas;
    var tieneVendedor = !string.IsNullOrWhiteSpace(vendedor?.DNI);
}

<div class="chat-page-wrapper primerElemento">

    <a class="det-volver" href="javascript:history.back()">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6l6 6"/></svg>
        Volver
    </a>

    <div class="chat-page">

        @* ── COL 1: Conversaciones ── *@
        <aside class="chat-col-conversations">
            <div class="chat-conv-header">
                <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M8 9h8"/><path d="M8 13h6"/><path d="M18 4a3 3 0 0 1 3 3v8a3 3 0 0 1 -3 3h-5l-5 3v-3h-2a3 3 0 0 1 -3 -3v-8a3 3 0 0 1 3 -3h12z"/></svg>
                <h2>Mensajes</h2>
                <button class="chat-nuevo-btn" id="chatNuevoBtn" title="Nueva conversación" aria-label="Nueva conversación">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
                </button>
            </div>

            @* Search bar *@
            <div class="chat-search-wrap">
                <svg class="chat-search-icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
                <input
                    type="search"
                    class="chat-search-input"
                    id="chatSearchInput"
                    placeholder="Buscar conversación..."
                    aria-label="Buscar conversación" />
            </div>

            <div class="chat-conv-list" id="chatConvList">
                @* Los items se renderizan dinámicamente via JS al cargar *@
                @* Skeletons de carga inicial *@
                <div class="chat-conv-item chat-conv-item--skeleton" id="chatSkeleton1">
                    <div class="chat-conv-avatar chat-conv-avatar--placeholder"></div>
                    <div class="chat-conv-meta">
                        <span class="chat-conv-nombre chat-skeleton chat-skeleton--sm"></span>
                        <span class="chat-conv-preview chat-skeleton chat-skeleton--lg"></span>
                    </div>
                </div>
                <div class="chat-conv-item chat-conv-item--skeleton" id="chatSkeleton2">
                    <div class="chat-conv-avatar chat-conv-avatar--placeholder"></div>
                    <div class="chat-conv-meta">
                        <span class="chat-conv-nombre chat-skeleton chat-skeleton--sm"></span>
                        <span class="chat-conv-preview chat-skeleton chat-skeleton--lg"></span>
                    </div>
                </div>
            </div>

            @* Mensaje "sin resultados" para la búsqueda *@
            <div class="chat-search-empty" id="chatSearchEmpty" hidden>
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
                <span>Sin resultados</span>
            </div>
        </aside>

        @* ── COL 2: Ventana de chat ── *@
        <main class="chat-col-messages">
            <div class="chat-messages-header@(tieneVendedor ? " chat-messages-header--clickable" : "")" id="chatMessagesHeader">
                @* Botón volver — solo visible en móvil (≤600px) via CSS *@
                <button class="chat-back-btn" id="chatBackBtn" aria-label="Volver a conversaciones">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6l6 6"/></svg>
                </button>
                @if (tieneVendedor)
                {
                    var avatarVendedorSrc = !string.IsNullOrWhiteSpace(vendedor?.fotoPerfil)
                        ? vendedor.fotoPerfil
                        : Url.Content("~/img/default.webp");
                    <img class="chat-conv-avatar" src="@avatarVendedorSrc" alt="@vendedor.nombreComp" />
                    <div class="chat-messages-header-info">
                        <p class="chat-messages-nombre">@vendedor.nombreComp</p>
                        <p class="chat-messages-sub">
                            @if (vendedor.ano.HasValue)
                            {
                                @HtmlHelpers.PasarAñoATextoCompleto(vendedor.ano.Value)
                                if (!string.IsNullOrWhiteSpace(vendedor.especialidad))
                                {
                                    <text> · @vendedor.especialidad</text>
                                }
                            }
                            else if (!string.IsNullOrWhiteSpace(vendedor.especialidad))
                            {
                                @vendedor.especialidad
                            }
                        </p>
                    </div>
                    <button class="chat-ver-perfil-btn" id="chatVerPerfilBtn" aria-label="Ver perfil del vendedor" title="Ver perfil">
                        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg>
                        <span>Perfil</span>
                    </button>
                }
                <!-- else
                {
                    <p class="chat-messages-nombre" style="color: rgba(6,26,64,0.35)">Seleccioná una conversación</p>
                } -->
            </div>

            <div class="chat-messages-body" id="chatMessagesBody">
                @* Loader — visible mientras se cargan mensajes por primera vez *@
                <div class="chat-mensajes-loader" id="chatMensajesLoader" style="display:none">
                    <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="chat-mensajes-spinner"><path d="M12 3a9 9 0 1 0 9 9"/></svg>
                </div>
                @* Estado vacío — oculto si ya hay un vendedor activo al entrar *@
                <div class="chat-empty-state" id="chatEmptyState"@(tieneVendedor ? " style=\"display:none\"" : "")>
                    <div class="chat-empty-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="46" height="46" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M8 9h8"/><path d="M8 13h6"/><path d="M18 4a3 3 0 0 1 3 3v8a3 3 0 0 1 -3 3h-5l-5 3v-3h-2a3 3 0 0 1 -3 -3v-8a3 3 0 0 1 3 -3h12z"/></svg>
                    </div>
                    @if (tieneVendedor)
                    {
                        <p class="chat-empty-title">Iniciá la conversación</p>
                        <p class="chat-empty-sub">Todavía no hay mensajes con <strong>@vendedor.nombreComp</strong>.<br/>¡Mandá el primero!</p>
                    }
                    else
                    {
                        <p class="chat-empty-title">Iniciar conversación</p>
                        <p class="chat-empty-sub">Elige entre tus conversaciones existentes o empieza una nueva.</p>
                        <button class="chat-empty-nuevo-btn" id="chatEmptyNuevoBtn">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
                            Nuevo chat
                        </button>
                    }
                </div>
            </div>

            <div class="chat-messages-input-wrap" id="chatInputWrap" style="@(!tieneVendedor ? "display:none" : "")">

                @* ── Panel picker de publicaciones (se abre con el botón +) ── *@
                <div class="chat-attach-panel" id="chatAttachPanel" hidden>
                    <div class="chat-attach-panel-header">
                        <span class="chat-attach-panel-title">Compartir publicación</span>
                        <button class="chat-attach-panel-close" id="chatAttachClose" aria-label="Cerrar">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6l-12 12"/><path d="M6 6l12 12"/></svg>
                        </button>
                    </div>
                    <div class="chat-attach-panel-body" id="chatAttachBody">
                        @* Contenido cargado dinámicamente via JS *@
                        <div class="chat-attach-loading" id="chatAttachLoading">
                            <svg class="chat-attach-spinner" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a9 9 0 1 0 9 9"/></svg>
                        </div>
                    </div>
                </div>

                @* ── Menú de acciones del "+" (WhatsApp-style) ── *@
                <div class="chat-actions-menu" id="chatActionsMenu" hidden>
                    <button class="chat-actions-item" id="chatActionMencionar" type="button">
                        <span class="chat-actions-item-icon chat-actions-item-icon--book">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 19a9 9 0 0 1 9 0a9 9 0 0 1 9 0"/><path d="M3 6a9 9 0 0 1 9 0a9 9 0 0 1 9 0"/><path d="M3 6v13"/><path d="M12 6v13"/><path d="M21 6v13"/></svg>
                        </span>
                        <span class="chat-actions-item-label">Mencionar publicación</span>
                    </button>
                    <button class="chat-actions-item" id="chatActionAcuerdo" type="button">
                        <span class="chat-actions-item-icon chat-actions-item-icon--deal">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 8V7a4 4 0 0 0-4-4c-2.4 0-4 1.6-4 4"/><path d="M6 8h12l1 12H5z"/><path d="M12 12v4"/></svg>
                        </span>
                        <span class="chat-actions-item-label">Acordar precio</span>
                    </button>
                    @* ── Espacio para futuras opciones ── *@
                    @* Descomentar y adaptar cuando se implementen nuevas funciones:
                    <button class="chat-actions-item" id="chatActionFoto" type="button" disabled>
                        <span class="chat-actions-item-icon chat-actions-item-icon--photo">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3z"/><circle cx="12" cy="13" r="3"/></svg>
                        </span>
                        <span class="chat-actions-item-label">Foto</span>
                    </button>
                    <button class="chat-actions-item" id="chatActionArchivo" type="button" disabled>
                        <span class="chat-actions-item-icon chat-actions-item-icon--file">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                        </span>
                        <span class="chat-actions-item-label">Archivo</span>
                    </button>
                    *@
                </div>

                <div class="chat-messages-input-row">
                    @* Botón "+" para abrir el menú de acciones *@
                    <button class="chat-attach-btn" id="chatAttachBtn" aria-label="Adjuntar" aria-expanded="false" title="Adjuntar">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 5v14"/>
                            <path d="M5 12h14"/>
                        </svg>
                    </button>

                    <div
                        class="chat-input"
                        id="chatInput"
                        contenteditable="true"
                        role="textbox"
                        aria-multiline="true"
                        aria-label="Escribir mensaje"
                        data-placeholder="Escribí un mensaje...">@if (publicacionConsulta != null)
                        {<text>Hola! Estoy interesado/a en tu publicación del libro <a class="chat-msg-publi-link" href="@Url.Action("Detalle", "Book", new { id = publicacionConsulta.id })" target="_blank" rel="noopener noreferrer" contenteditable="false">@publicacionConsulta.nombre</a>.</text>}</div>
                    <button class="chat-send-btn" id="chatSendBtn" aria-label="Enviar mensaje">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                            <path d="M10 14l11 -11"/>
                            <path d="M21 3l-6.5 18a.55 .55 0 0 1 -1 0l-3.5 -7l-7 -3.5a.55 .55 0 0 1 0 -1l18 -6.5"/>
                        </svg>
                    </button>
                </div>
            </div>
        </main>

        @* ── COL 3: Widget del contacto (se rellena dinámicamente via JS) ── *@
        <aside class="det-col-vendedor chat-col-vendedor" id="chatColVendedor">
            @* El widget se construye progresivamente por JS (skeleton → info → reseñas → publicaciones).
               Si no hay contacto activo, el JS muestra el placeholder vacío. *@
            @if (!tieneVendedor)
            {
                @* Placeholder cuando no hay conversación activa — el JS lo reemplaza al abrir un chat *@
                <div class="chat-widget-empty" id="chatWidgetEmpty">
                    <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                        <path d="M8 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0"/>
                        <path d="M6 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2"/>
                    </svg>
                    <p>Seleccioná una conversación para ver un perfil de contacto.</p>
                </div>
            }
        </aside>

    </div>
</div>

@section Scripts {
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js" crossorigin="anonymous"></script>


@* ── Drawer del vendedor (mobile) ── *@
<div class="chat-vendedor-overlay" id="chatVendedorOverlay" aria-hidden="true"></div>
<div class="chat-vendedor-drawer" id="chatVendedorDrawer" role="dialog" aria-modal="true" aria-label="Perfil del vendedor">
    <div class="chat-vendedor-drawer-handle"></div>
    <div id="chatVendedorDrawerContent"></div>
</div>
<div class="avatar-modal-overlay" id="chatAvatarModal" role="dialog" aria-modal="true" aria-label="Foto de perfil ampliada">
    <img class="avatar-modal-img" id="chatAvatarModalImg" src="" alt="Foto de perfil ampliada" />
</div>

@* ── Modal: Acordar precio ── *@
<div id="chatAcuerdoModal" hidden role="dialog" aria-modal="true" aria-labelledby="chatAcuerdoTitulo">
    <div class="chat-acuerdo-overlay" id="chatAcuerdoOverlay"></div>
    <div class="chat-acuerdo-dialog">

        <div class="chat-acuerdo-dialog-header">
            <button class="chat-acuerdo-back-btn" id="chatAcuerdoBackBtn" aria-label="Volver" hidden>
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6l6 6"/></svg>
            </button>
            <div class="chat-acuerdo-dialog-header-text">
                <h2 class="chat-acuerdo-dialog-titulo" id="chatAcuerdoTitulo">Acordar precio</h2>
                <p class="chat-acuerdo-dialog-desc" id="chatAcuerdoDesc">Elegí una publicación para proponer un acuerdo</p>
            </div>
            <button class="chat-acuerdo-dialog-close" id="chatAcuerdoClose" aria-label="Cerrar">
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6l-12 12"/><path d="M6 6l12 12"/></svg>
            </button>
        </div>

        @* Indicador de pasos *@
        <div class="chat-acuerdo-steps" id="chatAcuerdoSteps">
            <div class="chat-acuerdo-step chat-acuerdo-step--active" data-step="1">
                <span class="chat-acuerdo-step-num">1</span>
                <span class="chat-acuerdo-step-label">Publicación</span>
            </div>
            <div class="chat-acuerdo-step-line"></div>
            <div class="chat-acuerdo-step" data-step="2">
                <span class="chat-acuerdo-step-num">2</span>
                <span class="chat-acuerdo-step-label">Detalles</span>
            </div>
        </div>

        @* PASO 1: Selección de publicación *@
        <div class="chat-acuerdo-body" id="chatAcuerdoStep1">
            <div class="chat-acuerdo-loading" id="chatAcuerdoPubsLoader" hidden>
                <svg class="chat-attach-spinner" xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a9 9 0 1 0 9 9"/></svg>
            </div>
            <div id="chatAcuerdoPubsList"></div>
        </div>

        @* PASO 2: Formulario de detalles *@
        <div class="chat-acuerdo-step2-wrap" id="chatAcuerdoStep2" hidden>
            @* Publicación seleccionada (mini card de confirmación) *@
            <div class="chat-acuerdo-pub-seleccionada" id="chatAcuerdoPubCard"></div>

            <form id="chatAcuerdoForm" novalidate>
            <div class="chat-acuerdo-body">
                <div class="chat-acuerdo-form">
                    <div class="chat-acuerdo-form-row">
                        <label class="chat-acuerdo-label" for="acuerdoPrecio">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                            Precio propuesto
                        </label>
                        <div class="chat-acuerdo-input-wrap chat-acuerdo-input-wrap--prefix">
                            <span class="chat-acuerdo-prefix">$</span>
                            <input type="number" id="acuerdoPrecio" class="chat-acuerdo-input" placeholder="0" min="0" step="1" required />
                        </div>
                    </div>

                    <div class="chat-acuerdo-form-row">
                        <label class="chat-acuerdo-label" for="acuerdoFecha">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                            Fecha de encuentro
                        </label>
                        <input type="date" id="acuerdoFecha" class="chat-acuerdo-input" required />
                    </div>

                    <div class="chat-acuerdo-form-row">
                        <label class="chat-acuerdo-label" for="acuerdoHora">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                            Horario
                        </label>
                        <input type="time" id="acuerdoHora" class="chat-acuerdo-input" required />
                    </div>

                    <div class="chat-acuerdo-form-row">
                        <label class="chat-acuerdo-label" for="acuerdoLugar">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                            Lugar de encuentro
                        </label>
                        <input type="text" id="acuerdoLugar" class="chat-acuerdo-input" placeholder="Ej: Entrada del edificio A" maxlength="120" required />
                    </div>
                </div>
            </div>

            <div class="chat-acuerdo-actions">
                <button class="chat-acuerdo-send-btn" id="chatAcuerdoSendBtn" type="submit">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M10 14l11 -11"/><path d="M21 3l-6.5 18a.55 .55 0 0 1 -1 0l-3.5 -7l-7 -3.5a.55 .55 0 0 1 0 -1l18 -6.5"/></svg>
                    Enviar propuesta
                </button>
            </div>
            </form>
        </div>

    </div>
</div>

@* ── Modal: Nueva conversación ── *@
<div id="chatNuevoModal" hidden role="dialog" aria-modal="true" aria-labelledby="chatNuevoTitulo">
    <div class="chat-nuevo-overlay" id="chatNuevoOverlay"></div>
    <div class="chat-nuevo-dialog">

        @* Header limpio *@
        <div class="chat-nuevo-dialog-header">
            <div class="chat-nuevo-dialog-header-text">
                <h2 class="chat-nuevo-dialog-titulo" id="chatNuevoTitulo">Nueva conversación</h2>
                <p class="chat-nuevo-dialog-desc">Buscá un usuario por nombre</p>
            </div>
            <button class="chat-nuevo-dialog-close" id="chatNuevoClose" aria-label="Cerrar">
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6l-12 12"/><path d="M6 6l12 12"/></svg>
            </button>
        </div>

        @* Buscador *@
        <div class="chat-nuevo-search-wrap">
            <svg class="chat-nuevo-search-icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
            <input
                type="search"
                class="chat-nuevo-search-input"
                id="chatNuevoSearchInput"
                placeholder="Escribí un nombre..."
                aria-label="Buscar usuario"
                autocomplete="off" />
        </div>

        @* Resultados *@
        <div class="chat-nuevo-results" id="chatNuevoResults">
            <div class="chat-nuevo-hint">
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
                <span>Escribí al menos 2 caracteres para buscar</span>
            </div>
        </div>

    </div>
</div>
<script src="https://cdn.socket.io/4.8.1/socket.io.min.js"></script>
<script>
    window.CHAT_CONFIG = {
        dniUsuario:    '@(((Bookly.Models.Usuarios)ViewBag.usuario)?.DNI ?? "")',
        dniVendedor:   '@(tieneVendedor ? vendedor.DNI : "")',
        tieneVendedor: @(tieneVendedor ? "true" : "false"),
        wsUrl:         '@(Environment.GetEnvironmentVariable("API_URL")?.Replace("/api","") ?? "http://localhost:3000")'
    };

    // Limpiar idPublicacion de la URL para que recargar la página
    // no vuelva a inyectar el mensaje predeterminado.
    // (Mismo patrón que WhatsApp Web / Slack con sus params de navegación.)
    (function () {
        var url = new URL(window.location.href);
        if (url.searchParams.has('idPublicacion')) {
            url.searchParams.delete('idPublicacion');
            history.replaceState(null, '', url.toString());
        }
    })();
</script>
<script src="~/js/chat.js" asp-append-version="true"></script>
}
