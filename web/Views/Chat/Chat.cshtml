@using Bookly.Helpers

@{
    ViewData["Title"] = "Chat";
    var vendedor = (Bookly.Models.Usuarios)ViewBag.Vendedor;
    var vendedorCerradas = (int)(ViewBag.VendedorVentasCerradas ?? 0);
    var publicacionConsulta = ViewBag.PublicacionConsulta as Bookly.Models.PublicacionesCompletas;

    var avatarVendedor = !string.IsNullOrWhiteSpace(vendedor?.fotoPerfil)
        ? vendedor.fotoPerfil
        : Url.Content("~/img/default.webp");

    var tieneVendedor = !string.IsNullOrWhiteSpace(vendedor?.DNI);
}

<link rel="stylesheet" href="~/css/chat.css" asp-append-version="true" />

<div class="chat-page-wrapper primerElemento">

    <a class="det-volver" href="javascript:history.back()">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6l6 6"/></svg>
        Volver
    </a>

    <div class="chat-page">

        @* ── COL 1: Conversaciones ── *@
        <aside class="chat-col-conversations">
            <div class="chat-conv-header">
                <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M8 9h8"/><path d="M8 13h6"/><path d="M18 4a3 3 0 0 1 3 3v8a3 3 0 0 1 -3 3h-5l-5 3v-3h-2a3 3 0 0 1 -3 -3v-8a3 3 0 0 1 3 -3h12z"/></svg>
                <h2>Mensajes</h2>
                <button class="chat-nuevo-btn" id="chatNuevoBtn" title="Nueva conversación" aria-label="Nueva conversación">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
                </button>
            </div>

            @* Search bar *@
            <div class="chat-search-wrap">
                <svg class="chat-search-icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
                <input
                    type="search"
                    class="chat-search-input"
                    id="chatSearchInput"
                    placeholder="Buscar conversación..."
                    aria-label="Buscar conversación" />
            </div>

            <div class="chat-conv-list" id="chatConvList">
                @* Conversación activa *@
                @if (tieneVendedor)
                {
                    <div class="chat-conv-item chat-conv-item--active" data-nombre="@vendedor.nombreComp.ToLowerInvariant()">
                        <img class="chat-conv-avatar" src="@avatarVendedor" alt="@vendedor.nombreComp" />
                        <div class="chat-conv-meta">
                            <span class="chat-conv-nombre">@vendedor.nombreComp</span>
                        </div>
                    </div>
                }
                @* Placeholders para otras conversaciones *@
                <div class="chat-conv-item" data-nombre="placeholder uno">
                    <div class="chat-conv-avatar chat-conv-avatar--placeholder"></div>
                    <div class="chat-conv-meta">
                        <span class="chat-conv-nombre chat-skeleton chat-skeleton--sm"></span>
                        <span class="chat-conv-preview chat-skeleton chat-skeleton--lg"></span>
                    </div>
                </div>
                <div class="chat-conv-item" data-nombre="placeholder dos">
                    <div class="chat-conv-avatar chat-conv-avatar--placeholder"></div>
                    <div class="chat-conv-meta">
                        <span class="chat-conv-nombre chat-skeleton chat-skeleton--sm"></span>
                        <span class="chat-conv-preview chat-skeleton chat-skeleton--lg"></span>
                    </div>
                </div>
            </div>

            @* Mensaje "sin resultados" para la búsqueda *@
            <div class="chat-search-empty" id="chatSearchEmpty" hidden>
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
                <span>Sin resultados</span>
            </div>
        </aside>

        @* ── COL 2: Ventana de chat ── *@
        <main class="chat-col-messages">
            <div class="chat-messages-header">
                @* Botón volver — solo visible en móvil (≤600px) via CSS *@
                <button class="chat-back-btn" id="chatBackBtn" aria-label="Volver a conversaciones">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6l6 6"/></svg>
                </button>
                @if (tieneVendedor)
                {
                    <img class="chat-conv-avatar" src="@avatarVendedor" alt="@vendedor.nombreComp" />
                    <div>
                        <p class="chat-messages-nombre">@vendedor.nombreComp</p>
                        <p class="chat-messages-sub">
                            @if (vendedor.ano.HasValue)
                            {
                                @HtmlHelpers.PasarAñoATextoCompleto(vendedor.ano.Value)
                                if (!string.IsNullOrWhiteSpace(vendedor.especialidad))
                                {
                                    <text> · @vendedor.especialidad</text>
                                }
                            }
                            else if (!string.IsNullOrWhiteSpace(vendedor.especialidad))
                            {
                                @vendedor.especialidad
                            }
                        </p>
                    </div>
                }
                else
                {
                    <p class="chat-messages-nombre" style="color: rgba(6,26,64,0.35)">Seleccioná una conversación</p>
                }
            </div>

            <div class="chat-messages-body" id="chatMessagesBody">
                @* Estado vacío — primera conversación *@
                <div class="chat-empty-state" id="chatEmptyState">
                    <div class="chat-empty-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M8 9h8"/><path d="M8 13h6"/><path d="M18 4a3 3 0 0 1 3 3v8a3 3 0 0 1 -3 3h-5l-5 3v-3h-2a3 3 0 0 1 -3 -3v-8a3 3 0 0 1 3 -3h12z"/></svg>
                    </div>
                    @if (tieneVendedor)
                    {
                        <p class="chat-empty-title">Iniciá la conversación</p>
                        <p class="chat-empty-sub">Todavía no hay mensajes con <strong>@vendedor.nombreComp</strong>.<br/>¡Mandá el primero!</p>
                    }
                    else
                    {
                        <p class="chat-empty-title">Tus mensajes</p>
                        <p class="chat-empty-sub">Seleccioná una conversación o iniciá una nueva.</p>
                    }
                </div>
            </div>

            <div class="chat-messages-input-wrap">
                <div class="chat-messages-input-row">
                    <div
                        class="chat-input"
                        id="chatInput"
                        contenteditable="true"
                        role="textbox"
                        aria-multiline="true"
                        aria-label="Escribir mensaje"
                        data-placeholder="Escribí un mensaje...">@if (publicacionConsulta != null)
                        {<text>Hola! Estoy interesado/a en tu publicación del libro <a class="chat-msg-publi-link" href="@Url.Action("Detalle", "Book", new { id = publicacionConsulta.id })" target="_blank" contenteditable="false">@publicacionConsulta.nombre</a>.</text>}</div>
                    <button class="chat-send-btn" id="chatSendBtn" aria-label="Enviar mensaje">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                            <path d="M10 14l11 -11"/>
                            <path d="M21 3l-6.5 18a.55 .55 0 0 1 -1 0l-3.5 -7l-7 -3.5a.55 .55 0 0 1 0 -1l18 -6.5"/>
                        </svg>
                    </button>
                </div>
            </div>
        </main>

        @* ── COL 3: Info del vendedor ── *@
        <aside class="det-col-vendedor chat-col-vendedor">
            @if (tieneVendedor)
            {
                <div class="det-vendedor-card">
                    <div class="det-vendedor-top">
                        <img src="@avatarVendedor" alt="perfil" class="det-vendedor-avatar" />
                        <div>
                            <span class="det-vendedor-pill">Vendedor</span>
                            <p class="det-vendedor-nombre">@vendedor.nombreComp</p>
                            <p class="det-vendedor-sub">
                                @if (vendedor.ano.HasValue)
                                {
                                    @HtmlHelpers.PasarAñoATextoCompleto(vendedor.ano.Value)
                                    if (!string.IsNullOrWhiteSpace(vendedor.especialidad) || !string.IsNullOrWhiteSpace(vendedor.curso))
                                    {
                                        <text> · </text>
                                    }
                                }
                                @vendedor.especialidad @vendedor.curso
                            </p>
                            @if (!string.IsNullOrWhiteSpace(vendedor.aboutMe))
                            {
                                <p class="det-vendedor-about">@vendedor.aboutMe</p>
                            }
                        </div>
                    </div>

                    @* Widget de stats *@
                    <div class="det-vendedor-stats-widget">
                        <div class="det-rep-barra-segmentada">
                            <div class="det-rep-seg det-rep-seg-1"></div>
                            <div class="det-rep-seg det-rep-seg-2"></div>
                            <div class="det-rep-seg det-rep-seg-3"></div>
                            <div class="det-rep-seg det-rep-seg-4"></div>
                            <div class="det-rep-seg det-rep-seg-5 det-rep-seg--activo"></div>
                        </div>
                        <div class="det-rep-stats-row">
                            <div class="det-rep-stat det-rep-stat--ventas">
                                <span class="det-rep-stat-num">+@vendedorCerradas</span>
                                <span class="det-rep-stat-desc">ventas</span>
                            </div>
                            <div class="det-rep-divider"></div>
                            <div class="det-rep-stat">
                                <div class="det-rep-stat-icon-wrap">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M8 9h8"/><path d="M8 13h6"/><path d="M18 4a3 3 0 0 1 3 3v8a3 3 0 0 1 -3 3h-5l-5 3v-3h-2a3 3 0 0 1 -3 -3v-8a3 3 0 0 1 3 -3h12z"/></svg>
                                    <span class="det-rep-check">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="currentColor"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M17 3.34a10 10 0 1 1 -14.995 8.984l-.005 -.324l.005 -.324a10 10 0 0 1 14.995 -8.336zm-1.293 5.953a1 1 0 0 0 -1.32 -.083l-.094 .083l-3.293 3.292l-1.293 -1.292l-.094 -.083a1 1 0 0 0 -1.403 1.403l.083 .094l2 2l.094 .083a1 1 0 0 0 1.226 0l.094 -.083l4 -4l.083 -.094a1 1 0 0 0 -.083 -1.32z"/></svg>
                                    </span>
                                </div>
                                <span class="det-rep-stat-desc">Buena atención</span>
                            </div>
                            <div class="det-rep-divider"></div>
                            <div class="det-rep-stat">
                                <div class="det-rep-stat-icon-wrap">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><circle cx="12" cy="12" r="9"/><path d="M12 7v5l2.5 2.5"/></svg>
                                    <span class="det-rep-check">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="currentColor"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M17 3.34a10 10 0 1 1 -14.995 8.984l-.005 -.324l.005 -.324a10 10 0 0 1 14.995 -8.336zm-1.293 5.953a1 1 0 0 0 -1.32 -.083l-.094 .083l-3.293 3.292l-1.293 -1.292l-.094 -.083a1 1 0 0 0 -1.403 1.403l.083 .094l2 2l.094 .083a1 1 0 0 0 1.226 0l.094 -.083l4 -4l.083 -.094a1 1 0 0 0 -.083 -1.32z"/></svg>
                                    </span>
                                </div>
                                <span class="det-rep-stat-desc">Entrega a tiempo</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </aside>

    </div>
</div>

@section Scripts {

@* ── Modal: Nueva conversación ── *@
<div id="chatNuevoModal" hidden role="dialog" aria-modal="true" aria-labelledby="chatNuevoTitulo">
    <div class="chat-nuevo-overlay" id="chatNuevoOverlay"></div>
    <div class="chat-nuevo-dialog">

        @* Header limpio *@
        <div class="chat-nuevo-dialog-header">
            <div class="chat-nuevo-dialog-header-text">
                <h2 class="chat-nuevo-dialog-titulo" id="chatNuevoTitulo">Nueva conversación</h2>
                <p class="chat-nuevo-dialog-desc">Buscá un usuario por nombre</p>
            </div>
            <button class="chat-nuevo-dialog-close" id="chatNuevoClose" aria-label="Cerrar">
                <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6l-12 12"/><path d="M6 6l12 12"/></svg>
            </button>
        </div>

        @* Buscador *@
        <div class="chat-nuevo-search-wrap">
            <svg class="chat-nuevo-search-icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
            <input
                type="search"
                class="chat-nuevo-search-input"
                id="chatNuevoSearchInput"
                placeholder="Escribí un nombre..."
                aria-label="Buscar usuario"
                autocomplete="off" />
        </div>

        @* Resultados *@
        <div class="chat-nuevo-results" id="chatNuevoResults">
            <div class="chat-nuevo-hint">
                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
                <span>Escribí al menos 2 caracteres para buscar</span>
            </div>
        </div>

    </div>
</div>
<script>
(function () {
    // ── contenteditable: placeholder y foco ──────────────
    const input = document.getElementById('chatInput');
    if (input) {
        // Mover el cursor al final del contenido pre-cargado
        const range = document.createRange();
        const sel   = window.getSelection();
        range.selectNodeContents(input);
        range.collapse(false);
        sel.removeAllRanges();
        sel.addRange(range);
        input.focus();

        // Mostrar/ocultar placeholder via clase
        function togglePlaceholder() {
            if (input.textContent.trim() === '') {
                input.classList.add('chat-input--empty');
            } else {
                input.classList.remove('chat-input--empty');
            }
        }
        input.addEventListener('input', togglePlaceholder);
        togglePlaceholder();
    }

    // ── Cerrar banner (ya no existe, limpieza defensiva) ─
    const chipClose = document.getElementById('chatPubliChipClose');
    const chip      = document.getElementById('chatInputRich');
    if (chipClose && chip) {
        chipClose.addEventListener('click', function () { chip.style.display = 'none'; });
    }

    // ── Buscar conversaciones ─────────────────────────────
    const searchInput = document.getElementById('chatSearchInput');
    const convList    = document.getElementById('chatConvList');
    const noResults   = document.getElementById('chatSearchEmpty');

    if (searchInput && convList) {
        searchInput.addEventListener('input', function () {
            const q = this.value.trim().toLowerCase();
            const items = convList.querySelectorAll('.chat-conv-item');
            let visible = 0;
            items.forEach(function (item) {
                const nombre = (item.dataset.nombre || '').toLowerCase();
                const match  = !q || nombre.includes(q);
                item.style.display = match ? '' : 'none';
                if (match) visible++;
            });
            if (noResults) noResults.hidden = visible > 0;
        });
    }

    // ── Botón nueva conversación ─────────────────────────
    const btnNuevo    = document.getElementById('chatNuevoBtn');
    const modalNuevo  = document.getElementById('chatNuevoModal');
    const modalOverlay = document.getElementById('chatNuevoOverlay');
    const modalClose  = document.getElementById('chatNuevoClose');
    const modalInput  = document.getElementById('chatNuevoSearchInput');
    const modalResults = document.getElementById('chatNuevoResults');

    const HINT_HTML = '<div class="chat-nuevo-hint">'
        + '<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>'
        + '<span>Escribí al menos 2 caracteres para buscar</span>'
        + '</div>';

    const EMPTY_HTML = '<div class="chat-nuevo-hint">'
        + '<svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><circle cx="12" cy="12" r="9"/><path d="M9 10h.01"/><path d="M15 10h.01"/><path d="M9.5 15.25a3.5 3.5 0 0 1 5 0"/></svg>'
        + '<span>Sin resultados para esa búsqueda</span>'
        + '</div>';

    function abrirModalNuevo() {
        if (!modalNuevo) return;
        modalNuevo.removeAttribute('hidden');
        if (modalResults) modalResults.innerHTML = HINT_HTML;
        if (modalInput)   { modalInput.value = ''; modalInput.focus(); }
    }

    function cerrarModalNuevo() {
        if (!modalNuevo) return;
        const dialog  = modalNuevo.querySelector('.chat-nuevo-dialog');
        const overlay = modalNuevo.querySelector('.chat-nuevo-overlay');
        if (dialog)  dialog.style.animation  = 'chatDialogOut 0.18s cubic-bezier(0.4,0,1,1) forwards';
        if (overlay) overlay.style.animation = 'chatOverlayOut 0.18s ease forwards';
        setTimeout(function () {
            modalNuevo.setAttribute('hidden', '');
            if (dialog)  dialog.style.animation  = '';
            if (overlay) overlay.style.animation = '';
        }, 170);
    }

    // ── Renderizar un resultado ──────────────────────────
    function buildResultItem(u) {
        const avatar = u.fotoPerfil
            ? `<img class="chat-nuevo-result-avatar" src="${u.fotoPerfil}" alt="${u.nombre}" />`
            : `<div class="chat-nuevo-result-avatar chat-nuevo-result-avatar--default"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/></svg></div>`;

        let sub = '';
        if (u.ano)         sub += u.ano + '° año';
        if (u.especialidad) sub += (sub ? ' · ' : '') + u.especialidad;

        const item = document.createElement('a');
        item.className  = 'chat-nuevo-result-item';
        item.href       = `/Chat/Chat?vendedorDNI=${encodeURIComponent(u.dni)}`;
        item.innerHTML  = avatar
            + `<div class="chat-nuevo-result-info">`
            +   `<div class="chat-nuevo-result-nombre">${u.nombre}</div>`
            +   (sub ? `<div class="chat-nuevo-result-sub">${sub}</div>` : '')
            + `</div>`
            + `<svg class="chat-nuevo-result-arrow" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="M5 12h14"/></svg>`;
        return item;
    }

    // ── Búsqueda con debounce ────────────────────────────
    let debounceTimer = null;

    function buscarUsuarios(q) {
        clearTimeout(debounceTimer);
        if (q.length < 2) {
            modalResults.innerHTML = HINT_HTML;
            return;
        }
        // Skeleton de carga
        modalResults.innerHTML = '<div class="chat-nuevo-hint chat-nuevo-hint--loading">'
            + '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="chat-nuevo-spinner"><path d="M12 3a9 9 0 1 0 9 9"/></svg>'
            + '</div>';

        debounceTimer = setTimeout(function () {
            fetch('/Chat/BuscarUsuarios?q=' + encodeURIComponent(q))
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    if (!data || data.length === 0) {
                        modalResults.innerHTML = EMPTY_HTML;
                        return;
                    }
                    modalResults.innerHTML = '';
                    data.forEach(function (u) {
                        modalResults.appendChild(buildResultItem(u));
                    });
                })
                .catch(function () {
                    modalResults.innerHTML = EMPTY_HTML;
                });
        }, 280);
    }

    if (modalInput) {
        modalInput.addEventListener('input', function () {
            buscarUsuarios(this.value.trim());
        });
    }

    if (btnNuevo)      btnNuevo.addEventListener('click', abrirModalNuevo);
    if (modalClose)    modalClose.addEventListener('click', cerrarModalNuevo);
    if (modalOverlay)  modalOverlay.addEventListener('click', cerrarModalNuevo);
    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') cerrarModalNuevo();
    });

    // ── Navegación por paneles (móvil ≤600px) ────────────
    const chatPage       = document.querySelector('.chat-page');
    const backBtn        = document.getElementById('chatBackBtn');
    const MOBILE_BP      = 600;

    function esMobil() { return window.innerWidth <= MOBILE_BP; }

    // Si ya hay vendedor cargado al entrar, mostrar panel chat en móvil
    if (esMobil() && @(tieneVendedor ? "true" : "false")) {
        chatPage && chatPage.classList.add('chat-page--panel-chat');
    }

    // Al tocar un ítem de la lista de conversaciones
    if (convList) {
        convList.addEventListener('click', function (e) {
            if (!esMobil()) return;
            const item = e.target.closest('.chat-conv-item');
            if (!item) return;
            // Solo navegar si el ítem tiene href (conversación real)
            // Los items actuales son divs, así que solo activamos el panel
            chatPage && chatPage.classList.add('chat-page--panel-chat');
        });
    }

    // Botón volver
    if (backBtn) {
        backBtn.addEventListener('click', function () {
            chatPage && chatPage.classList.remove('chat-page--panel-chat');
        });
    }

    // Al redimensionar de móvil a desktop, quitar el override de display
    window.addEventListener('resize', function () {
        if (!esMobil()) {
            chatPage && chatPage.classList.remove('chat-page--panel-chat');
        }
    });

    // ── Scroll al fondo del chat ──────────────────────────
    const body = document.getElementById('chatMessagesBody');
    if (body) body.scrollTop = body.scrollHeight;
})();
</script>
}
