@using Bookly.Helpers;

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Bookly</title>
    <link rel="icon" type="image/svg+xml" href="~/img/logo-icon.png" asp-append-version="true" />
    <link rel="icon" type="image/x-icon" href="~/img/logo-icon.png" asp-append-version="true" />
    <link rel="shortcut icon" type="image/x-icon" href="~/logo-icon.png" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/resena-modal.css" asp-append-version="true" />
</head>
<body>
    <div id="appConfig" hidden
         data-login-url="@Url.Action("Login", "Usuarios")"
         @if (ViewBag.usuario == null) { <text>data-publicar-login-url="@Url.Action("Login", "Usuarios", new { returnView = "Publicar" })"</text> }
         @if (TempData["ModalError"] != null) {
             <text>data-modal-error="@(TempData["ModalError"]?.ToString() ?? "")" data-modal-error-target="@(TempData["ModalErrorTarget"]?.ToString() ?? "login")"</text>
         }></div>
    @* ── Page Loader — al inicio del body para que esté disponible inmediatamente ── *@
    <div id="pageLoader" role="status" aria-label="Cargando">
        <div class="loader-inner">
            <div class="loader-spinner"></div>
            <svg class="loader-logo" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                <path d="M3 19a9 9 0 0 1 9 0a9 9 0 0 1 9 0" />
                <path d="M3 6a9 9 0 0 1 9 0a9 9 0 0 1 9 0" />
                <path d="M3 6l0 13" />
                <path d="M12 6l0 13" />
                <path d="M21 6l0 13" />
            </svg>
        </div>
        <div class="loader-dots">
            <span></span><span></span><span></span>
        </div>
    </div>
    @{
        var usuario = ViewBag?.usuario;
        string nombreMostrable;
        if(usuario?.nombreComp != null) nombreMostrable = usuario.nombreComp;
        else nombreMostrable = "Iniciar sesión";
    }
    <header class="@(usuario == null ? "header--guest" : "")">
        <a href="@Url.Action("Index", "Home")"><svg class="logoSvg" id="Capa_1" data-name="Capa 1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 549.51 635.51">
            <image href="@Url.Content("~/img/logo-icon.png")" x="11" y="0" width="527" height="473"/>
            <text class="cls-2" transform="translate(37 595.77) scale(.96 1)"><tspan x="0" y="0">Book</tspan><tspan class="cls-3" x="369.84" y="0">l</tspan><tspan x="402.62" y="0">y</tspan></text>
        </svg></a>
        @if (ViewData["Title"]?.ToString() != "Login" && ViewData["Title"]?.ToString() != "Registrarse"){
        @if (usuario != null) {
        <section class="searchNFilter">            <div class="search">
                <input autocomplete="off" id="searchInput" name="query" type="text" placeholder="Buscar un libro..." class="busqueda-input" value="@(ViewData["Title"]?.ToString() == "Resultados de búsqueda" ? ViewBag.query : "")" />
                <div class="search-icon">
                    <svg id="searchInputIcon" xmlns="http://www.w3.org/2000/svg" width="24" height="24"
                        viewBox="0 0 24 24" fill="none" stroke="currentColor"
                        stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                        class="icon icon-tabler icons-tabler-outline icon-tabler-search">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                        <path d="M10 10m-7 0a7 7 0 1 0 14 0a7 7 0 1 0 -14 0" />
                        <path d="M21 21l-6 -6" />
                    </svg>
                </div>
            </div>
        </section>
        }
        <nav class="navSections">

            @if (usuario != null) {
            <button class="header-search-btn" id="headerSearchBtn" aria-label="Buscar" aria-expanded="false">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M10 10m-7 0a7 7 0 1 0 14 0a7 7 0 1 0 -14 0" /><path d="M21 21l-6 -6"/></svg>
            </button>
            <button class="header-hamburger" id="headerHamburger" aria-label="Más opciones">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M4 6l16 0"/><path d="M4 12l16 0"/><path d="M4 18l16 0"/></svg>
                <span class="nav-chat-badge nav-chat-badge--hamburger" id="navChatBadgeHamburger" style="display:none"></span>
            </button>
            <div class="header-hamburger-menu" id="headerHamburgerMenu">
            <button class="favBtn" id="notifBtnHeader" title="Notificaciones" aria-label="Notificaciones" aria-expanded="false">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                    <path d="M10 5a2 2 0 1 1 4 0a7 7 0 0 1 4 6v3a4 4 0 0 0 2 3h-16a4 4 0 0 0 2 -3v-3a7 7 0 0 1 4 -6" />
                    <path d="M9 17v1a3 3 0 0 0 6 0v-1" />
                </svg>
                @{
                    var notifCount = (ViewBag.Notificaciones as List<Bookly.Models.Notificacion>)?.Count ?? 0;
                }
                @if (notifCount > 0)
                {
                    <span class="notif-badge">@(notifCount > 9 ? "9+" : notifCount.ToString())</span>
                }
            </button>
            <a class="favBtn" id="chatBtnHeader" href="@Url.Action("Index", "Chat")" title="Mensajes">
                <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                    <path d="M8 9h8" />
                    <path d="M8 13h6" />
                    <path d="M18 4a3 3 0 0 1 3 3v8a3 3 0 0 1 -3 3h-5l-5 3v-3h-2a3 3 0 0 1 -3 -3v-8a3 3 0 0 1 3 -3h12z" />
                </svg>
                @if ((bool)(ViewBag.TieneNoLeidos ?? false))
                {
                    <span class="nav-chat-badge" id="navChatBadge"></span>
                }
                else
                {
                    <span class="nav-chat-badge" id="navChatBadge" style="display:none"></span>
                }
            </a>
            <a class="favBtn" id="favBtnHeader" href="@Url.Action("Profile", "Home")#favoritos" title="Mis favoritos">
                <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                    <path d="M19.5 12.572l-7.5 7.428l-7.5 -7.428a5 5 0 1 1 7.5 -6.566a5 5 0 1 1 7.5 6.572" />
                </svg>
            </a>
            <a class="favBtn hamburger-logout-btn" href="@Url.Action("Logout", "Usuarios")" title="Cerrar sesión" aria-label="Cerrar sesión">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M10 8v-2a2 2 0 0 1 2 -2h7a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-7a2 2 0 0 1 -2 -2v-2" /><path d="M15 12h-12l3 -3" /><path d="M6 15l-3 -3" /></svg>
            </a>
            </div>
            <div class="profileBtn@(ViewData["Title"]?.ToString() == "Perfil" ? " activeNavBtn" : "")" id="profileDropdownWrap">
                <a href="@Url.Action("Profile", "Home")" id="profileNavLink">
                    <p>@HtmlHelpers.ToUpperPrimeraLetra(nombreMostrable)</p>
                    @{
                        var fotoNav = usuario?.fotoPerfil as string;
                    }
                    @if (!string.IsNullOrWhiteSpace(fotoNav))
                    {
                        <img src="@fotoNav" alt="foto de perfil" class="nav-avatar" />
                    }
                    else
                    {
                        <svg class="simpleBtn" xmlns="http://www.w3.org/2000/svg" width="50" height="50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                            <path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0" />
                            <path d="M12 10m-3 0a3 3 0 1 0 6 0a3 3 0 1 0 -6 0" />
                            <path d="M6.168 18.849a4 4 0 0 1 3.832 -2.849h4a4 4 0 0 1 3.834 2.855" />
                        </svg>
                    }
                </a>
                <div class="profile-dropdown">
                  <div class="profile-dropdown-inner">
                    @if (ViewData["Title"]?.ToString() != "Perfil") {
                        <a class="profile-dropdown-item" href="@Url.Action("Profile", "Home")">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0" /><path d="M12 10m-3 0a3 3 0 1 0 6 0a3 3 0 1 0 -6 0" /><path d="M6.168 18.849a4 4 0 0 1 3.832 -2.849h4a4 4 0 0 1 3.834 2.855" /></svg>
                            Mi perfil
                        </a>
                        <div class="profile-dropdown-divider"></div>
                    }
                        <a class="profile-dropdown-item profile-dropdown-logout" href="@Url.Action("Logout", "Usuarios")">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M10 8v-2a2 2 0 0 1 2 -2h7a2 2 0 0 1 2 2v12a2 2 0 0 1 -2 2h-7a2 2 0 0 1 -2 -2v-2" /><path d="M15 12h-12l3 -3" /><path d="M6 15l-3 -3" /></svg>
                            Cerrar sesión
                        </a>
                  </div>
                </div>
            </div>

            } else {

            <button class="header-search-btn" id="headerSearchBtn" aria-label="Buscar" aria-expanded="false">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M10 10m-7 0a7 7 0 1 0 14 0a7 7 0 1 0 -14 0" /><path d="M21 21l-6 -6"/></svg>
            </button>
            <button class="nav-auth-btn nav-auth-btn--secondary" onclick="abrirLoginModal(event, 'Profile')">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M15 8v-2a2 2 0 0 0 -2 -2h-7a2 2 0 0 0 -2 2v12a2 2 0 0 0 2 2h7a2 2 0 0 0 2 -2v-2" /><path d="M21 12h-13l3 -3" /><path d="M11 15l-3 -3" /></svg>
                Iniciar sesión
            </button>
            <button class="nav-auth-btn nav-auth-btn--primary" onclick="abrirRegisterModal(event)">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M8 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0" /><path d="M16 19h6" /><path d="M19 16v6" /><path d="M6 21v-2a4 4 0 0 1 4 -4h4" /></svg>
                Registrarse
            </button>
            }
        </nav>
        }
    </header>

    @* ── Panel de notificaciones ── *@
    @if (usuario != null)
    {
        var notifs = ViewBag.Notificaciones as List<Bookly.Models.Notificacion> ?? new List<Bookly.Models.Notificacion>();
        <div class="notif-panel" id="notifPanel" aria-label="Notificaciones" hidden>
            <div class="notif-panel-header">
                <span class="notif-panel-titulo">Notificaciones</span>
                @if (notifs.Count > 0)
                {
                    <span class="notif-panel-count">@notifs.Count</span>
                }
            </div>
            <div class="notif-panel-lista">
                @if (notifs.Count == 0)
                {
                    <div class="notif-panel-empty">
                        <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                            <path d="M10 5a2 2 0 1 1 4 0a7 7 0 0 1 4 6v3a4 4 0 0 0 2 3h-16a4 4 0 0 0 2 -3v-3a7 7 0 0 1 4 -6" />
                            <path d="M9 17v1a3 3 0 0 0 6 0v-1" />
                        </svg>
                        <p>No tenés ninguna notificación todavía :)</p>
                    </div>
                }
                else
                {
                    foreach (var notif in notifs)
                    {
                        if (!string.IsNullOrWhiteSpace(notif.Vinculo))
                        {
                            <a class="notif-item notif-item--link" href="@notif.Vinculo">
                                <div class="notif-item-icono">
                                    @if (!string.IsNullOrWhiteSpace(notif.IconoSvg))
                                    {
                                        @Html.Raw(notif.IconoSvg)
                                    }
                                    else
                                    {
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                                            <path d="M10 5a2 2 0 1 1 4 0a7 7 0 0 1 4 6v3a4 4 0 0 0 2 3h-16a4 4 0 0 0 2 -3v-3a7 7 0 0 1 4 -6" />
                                            <path d="M9 17v1a3 3 0 0 0 6 0v-1" />
                                        </svg>
                                    }
                                </div>
                                <div class="notif-item-texto">
                                    <span class="notif-item-titulo">@notif.Titulo</span>
                                    @if (!string.IsNullOrWhiteSpace(notif.Subtitulo))
                                    {
                                        <span class="notif-item-subtitulo">@notif.Subtitulo</span>
                                    }
                                </div>
                                <svg class="notif-item-arrow" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M9 6l6 6l-6 6"/>
                                </svg>
                            </a>
                        }
                        else
                        {
                            <div class="notif-item">
                                <div class="notif-item-icono">
                                    @if (!string.IsNullOrWhiteSpace(notif.IconoSvg))
                                    {
                                        @Html.Raw(notif.IconoSvg)
                                    }
                                    else
                                    {
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                                            <path d="M10 5a2 2 0 1 1 4 0a7 7 0 0 1 4 6v3a4 4 0 0 0 2 3h-16a4 4 0 0 0 2 -3v-3a7 7 0 0 1 4 -6" />
                                            <path d="M9 17v1a3 3 0 0 0 6 0v-1" />
                                        </svg>
                                    }
                                </div>
                                <div class="notif-item-texto">
                                    <span class="notif-item-titulo">@notif.Titulo</span>
                                    @if (!string.IsNullOrWhiteSpace(notif.Subtitulo))
                                    {
                                        <span class="notif-item-subtitulo">@notif.Subtitulo</span>
                                    }
                                </div>
                            </div>
                        }
                    }
                }
            </div>
        </div>
    }
    <main role="main">
        @RenderBody()
    </main>
    <footer>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/pageloader.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/helpers.js" asp-append-version="true"></script>
    @* ── Badge de mensajes no leídos en el navbar (tiempo real) ── *@
    @if (usuario != null)
    {
        <script src="https://cdn.socket.io/4.8.1/socket.io.min.js"></script>
        <script>
        (function () {
            var DNI    = '@(((Bookly.Models.Usuarios)usuario)?.DNI ?? "")';
            var WS_URL = '@(Environment.GetEnvironmentVariable("API_URL")?.Replace("/api","") ?? "http://localhost:3000")';
            if (!DNI) return;

            var socket = io(WS_URL, {
                query: { dni: DNI },
                transports: ['websocket', 'polling'],
                reconnectionAttempts: 10,
                reconnectionDelay: 2000
            });
            window.__booklySocket = socket;

            // Al recibir un mensaje nuevo en tiempo real, mostrar el puntito
            socket.on('nuevo-mensaje', function () {
                var b = document.getElementById('navChatBadge');
                if (b) b.style.display = '';
            });
        }());
        </script>
    }
    <script src="~/js/desear.js" asp-append-version="true"></script>
    <script src="~/js/buscar.js" asp-append-version="true"></script>
    <script src="~/js/publicar.js" asp-append-version="true"></script>
    <script src="~/js/profile.js" asp-append-version="true"></script>
    <script src="~/js/auth.js" asp-append-version="true"></script>
    <script src="~/js/layout.js" asp-append-version="true"></script>
    <script src="~/js/auth-modals.js" asp-append-version="true"></script>
    <script src="~/js/publicar-modal.js" asp-append-version="true"></script>
    <script src="~/js/resena-modal.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
    
    @await RenderSectionAsync("Scripts", required: false)

    @* ── Modal de login (solo para usuarios no logueados) ── *@
    @if (ViewBag.usuario == null)
    {
        <div class="login-modal-overlay" id="loginModal" onclick="cerrarLoginModal(event)">
            <div class="login-modal-card" role="dialog" aria-modal="true" aria-label="Iniciar sesión">
                <button class="login-modal-close" onclick="cerrarLoginModal()" aria-label="Cerrar">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6l-12 12"/><path d="M6 6l12 12"/></svg>
                </button>

                <div class="auth-header">
                    <div class="auth-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M8 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0" /><path d="M6 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2" /></svg>
                    </div>
                    <h1>Bienvenido de vuelta</h1>
                    <p>Ingresá tus datos para continuar</p>
                </div>

                <div id="loginModalError" class="auth-error" style="display:none;"></div>

                <form method="post" action="@Url.Action("Login", "Usuarios")" class="auth-form" id="loginModalForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnView" value="" />
                    <input type="hidden" name="returnUrl" value="" id="loginReturnUrl" />

                    <div class="campo">
                        <label for="modalDNI">DNI</label>
                        <input type="text" id="modalDNI" name="DNI" placeholder="Ingresá tu DNI" required autocomplete="off" pattern="\d+" inputmode="numeric" />
                    </div>

                    <div class="campo">
                        <label for="modalPassword">Contraseña</label>
                        <div class="campo-password">
                            <input type="password" id="modalPassword" name="password" placeholder="Ingresá tu contraseña" required />
                            <button type="button" class="ojo-btn" onclick="togglePassword('modalPassword', this)">
                                <svg class="ojo-off" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M10 12a2 2 0 1 0 4 0a2 2 0 0 0 -4 0" /><path d="M21 12c-2.4 4 -5.4 6 -9 6c-3.6 0 -6.6 -2 -9 -6c2.4 -4 5.4 -6 9 -6c3.6 0 6.6 2 9 6" /></svg>
                                <svg class="ojo-on" style="display:none" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M3 3l18 18" /><path d="M10.584 10.587a2 2 0 0 0 2.828 2.83" /><path d="M9.363 5.365a9 9 0 0 1 2.637 -.365c3.6 0 6.6 2 9 6c-.822 1.37 -1.722 2.519 -2.7 3.448m-2.168 1.816a9 9 0 0 1 -4.132 .736c-3.6 0 -6.6 -2 -9 -6c1.168 -1.948 2.494 -3.42 3.978 -4.418" /></svg>
                            </button>
                        </div>
                    </div>

                    <button type="submit" class="mainBtn auth-submit">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M14 8v-2a2 2 0 0 0 -2 -2h-7a2 2 0 0 0 -2 2v12a2 2 0 0 0 2 2h7a2 2 0 0 0 2 -2v-2" /><path d="M20 12h-13l3 -3m0 6l-3 -3" /></svg>
                        Iniciar sesión
                    </button>
                </form>

                <p class="auth-footer">
                    ¿No tenés cuenta? <a href="#" onclick="cerrarLoginModal(); abrirRegisterModal(); return false;">Registrate acá</a>
                </p>
            </div>
        </div>

        @* ── Modal de registro ── *@
        <div class="login-modal-overlay" id="registerModal" onclick="cerrarRegisterModal(event)">
            <div class="login-modal-card register-modal-card" role="dialog" aria-modal="true" aria-label="Registrarse">
                <button class="login-modal-close" onclick="cerrarRegisterModal()" aria-label="Cerrar">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6l-12 12"/><path d="M6 6l12 12"/></svg>
                </button>

                <div class="auth-header">
                    <div class="auth-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M8 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0" /><path d="M16 19h6"/><path d="M19 16v6"/><path d="M6 21v-2a4 4 0 0 1 4 -4h4"/></svg>
